    "db:studio": "drizzle-kit studio --config=/srv/www/app/src/lib/server/database/config.ts --host 127.0.0.1 --port 4984",
    "db:drop": "drizzle-kit drop --config=/srv/www/app/src/lib/server/database/config.ts",
